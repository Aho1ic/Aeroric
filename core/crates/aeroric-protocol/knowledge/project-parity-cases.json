      },
      "expected": {
        "project": {
          "id": "1700000011000",
          "name": "one",
          "path": "/repo/one",
          "lastOpenedAt": 1700000011000,
          "orderIndex": 0
        },
        "projects": [
          {
            "id": "1700000011000",
            "name": "one",
            "path": "/repo/one",
            "lastOpenedAt": 1700000011000,
            "orderIndex": 0
          },
          {
            "name": "1",
            "path": "/repo/one/",
            "lastOpenedAt": 1700000000000,
            "id": "1",
            "orderIndex": 1
          }
        ]
      },
      "coreExpected": {
        "project": {
          "id": "1",
          "name": "1",
          "path": "/repo/one/",
          "lastOpenedAt": 1700000011000,
          "orderIndex": 0
        },
        "projects": [
          {
            "id": "1",
            "name": "1",
            "path": "/repo/one/",
            "lastOpenedAt": 1700000011000,
            "orderIndex": 0
          }
        ]
      },
      "divergenceReason": "ADR-013: local identity is compared after lossless normalisation (trailing separators), so this touches the existing record instead of adding a second one."
