{
  "expo": {
    "name": "Aeroric",
    "slug": "aeroric-mobile",
    "version": "1.4.5",
    "scheme": "aeroric",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aeroric.mobile",
      "buildNumber": "10405",
      "infoPlist": {
        "NSCameraUsageDescription": "Aeroric 需要相机权限扫描桌面端的配对二维码",
        "NSLocalNetworkUsageDescription": "Aeroric 需要访问局域网以连接电脑上的远程服务",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.aeroric.mobile",
      "versionCode": 10405,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Aeroric 需要相机权限扫描桌面端的配对二维码",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "./plugins/with-android-lan-websocket",
      "./plugins/with-local-notifications-only",
      "./plugins/with-release-launch-scheme"
    ]
  }
}
