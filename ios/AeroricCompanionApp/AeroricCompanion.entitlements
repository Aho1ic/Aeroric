<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AP6: APNs push entitlement for the companion app.

  `development` is the value a locally-built/debug provisioning profile can
  carry; the App Store build must use `production`, which is issued with the real
  App ID at AP9 (GAP-STORE-06). Hard-coding `production` here would produce a
  bundle whose entitlement does not match its profile, and the failure mode is
  "notifications silently never arrive" — the worst possible signal.
-->
<plist version="1.0">
<dict>
  <key>aps-environment</key>
  <string>development</string>
</dict>
</plist>
