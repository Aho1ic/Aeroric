    "native:generate": "node scripts/native/generate.mjs",
    "native:build": "node scripts/native/build.mjs",
    "native:dev": "node scripts/native/dev.mjs",
    "native:check": "node scripts/native/check.mjs",
    "native:digest": "node scripts/native/digest.mjs --write",
    "native:contracts": "node scripts/native/contracts.mjs",
    "native:ui-test": "node scripts/native/ui-test.mjs",
