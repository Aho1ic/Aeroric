+fn append_xlsx_xml_text(target: &mut String, text: &BytesText<'_>) -> Result<(), String> {
+    target.push_str(&text.xml10_content().map_err(|error| error.to_string())?);
+    Ok(())
+}
+
+fn append_xlsx_xml_reference(target: &mut String, reference: &BytesRef<'_>) -> Result<(), String> {
+    if let Some(character) = reference.resolve_char_ref().map_err(|error| error.to_string())? {
+        target.push(character);
+        return Ok(());
+    }
+    let name = reference.decode().map_err(|error| error.to_string())?;
+    let value = resolve_predefined_entity(&name).ok_or_else(|| format!("Unknown XML entity: &{name};"))?;
+    target.push_str(value);
+    Ok(())
+}
